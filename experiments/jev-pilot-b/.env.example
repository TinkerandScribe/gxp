# Copy to .env locally. Never commit a filled key (repo gitignores .env).
# HTTP transport (optional; tests use an injected fake client):
JEV_API_KEY=
# TYPESAFE_API_KEY=
# JEV_BASE_URL=https://api.typesafe.ai/v1/systemone
# JEV_MODEL=jev-latest

# MCP usage: do not put the key in tool arguments. Configure jev-mcp / host
# MCP server env with JEV_API_KEY or TYPESAFE_API_KEY, then inject a
# JevCheckClient that forwards to the jev_check tool.
