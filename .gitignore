# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Python (adapters/tooling may use it)
__pycache__/
*.py[cod]
.venv/
venv/

# Ephemeral GXP audit artifacts
.ai/tmp/

# Local-only eval runs / scratch (never commit trial trees or fill dirs).
# Golden task fixtures (tasks/, harness/, prompts/) stay tracked for local testing.
core/evals/**/trials/
core/evals/**/_grok_fill/
**/_grok_fill/

# Cowork adapter — generated plugin artifacts (built from core/, not committed)
adapters/cowork/dist/

# Release staging — skill zip ships as a GitHub Release asset, never in-tree
/gxp-release-asset/

# Local-only project context — NEVER commit (see core/rules/02-local-context-never-committed.md).
# The repo holds public methodology only; a project's filled instance stays local.
/.ai/PROGRAM.md
/knowledge/
/local/

# Secrets
.env
.env.*
!.env.example
